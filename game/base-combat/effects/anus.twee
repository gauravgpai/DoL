	<<if $anusaction is "handtake" and ($NPCList[$anustarget].lefthand is "anus" or $NPCList[$anustarget].righthand is "anus")>>
		<<set $anusaction to 0>><<set $anusactiondefault to "handtake">><<actionshandanustake $anustarget>>
	<</if>>
<</widget>>
