		<<set $mouthaction to 0>><<set _sound to 1>>
		<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
			<<wheeze "scream for help">>
			<<set $speechChokedAction to "scream">>
		<<elseif $drugged gt 0 or $arousal gte $arousalmax * 0.9>>
			You try to scream for help, <span class="pink">but <<= $drugged gt 0 ? "your drugged state of mind" : "your arousal">> makes it sound like a lewd moan.</span>
			<<neutral 1>><<set $speechMoan to 1>>
		<<elseif $uncomfortable.hypnosis is false and $hypnosis_traits.scream gte random(1,5)>>
