:: Widgets speech-Harper [widget]
<<widget "speech-harper">>
	<<set _npc_speech to true>>
	<<speechPool "Harper">>
	<<if $player.virginity.penile is "Harper">>
		<<addEventSpeechLine "penisVirgin">>
			<<He>> smiles. "Hold still. I need to check your blood pressure."
		<</addEventSpeechLine>>
	<</if>>
	<<if $player.virginity.vaginal is "Harper">>
		<<addEventSpeechLine "vaginaVirgin">>
			<<He>> smiles. "This will only hurt a bit."
		<</addEventSpeechLine>>
	<</if>>
	<<if $player.virginity.anal is "Harper">>
		<<if $player.sex is "f">>
			<<addEventSpeechLine "anusVirgin">>
				<<He>> smiles. "I'm going to administer a suppository. Please, try to relax."
			<</addEventSpeechLine>>
		<<else>>
			<<addEventSpeechLine "anusVirgin">>
				<<He>> smiles. "You're overdue for a prostate examination. Please, try to relax."
			<</addEventSpeechLine>>
		<</if>>
	<</if>>
	<<if $player.virginity.oral is "Harper">>
		<<addEventSpeechLine "oralVirgin">>
			<<He>> smiles. "Say 'Ahh'..."
		<</addEventSpeechLine>>
	<</if>>
	<<if $player.virginity.kiss is "Harper">>
		<<addEventSpeechLine "kissVirgin">>
			<<He>> smiles. "How's my bedside manner?"
		<</addEventSpeechLine>>
	<</if>>
	<<addEventSpeechLine "LINameDrop">>
		<<set $speechLINameDrop to 0>>
		<<switch _loveInterest>>
			<<case "Gwylan">>
				<<He>> speaks. "Interesting. You've a very healthy imagination, to give your hallucination such a name."
			<<case "Black Wolf" "Great Hawk">>
				<<He>> shakes <<his>> head. "As I've said, such animals do not exist."
			<<default>>
				<<He>> nods. "Prior attachments. Noted."
		<</switch>>
	<</addEventSpeechLine>>
	<<speechSayOrPass>>
<</widget>>
