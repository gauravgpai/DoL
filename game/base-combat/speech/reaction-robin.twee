:: Widgets reaction-Robin [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-robin-plead">>
	<<speechLine>>"Robin, please stop!"<</speechLine>>
<</widget>>

<<widget "pcLine-robin-demand">>
	<<speechLine>>"Robin, stop! I don't want this!"<</speechLine>>
<</widget>>

<<widget "pcLine-robin-moan">>
	<<if C.npc.Robin.dom gte 70>>
		<<speechLine>><<set $speechSpecialDialogue to "robin_moan_dom">>"You know just how to turn me on."<</speechLine>>
	<<else>>
		<<speechLine>><<set $speechSpecialDialogue to "robin_moan_default">>"I'm gonna melt, you're making me so happy."<</speechLine>>
	<</if>>
<</widget>>
