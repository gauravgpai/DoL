	<</addEventSpeechLine>>
	<<addEventSpeechLine "playerOrgasm">>
		<<print $_stringsPre>>"Just something to remember me by."
	<</addEventSpeechLine>>
	<<addEventSpeechLine "playerOrgasm">>
