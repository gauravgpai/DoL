		<</addEventSpeechLine>>
		<<addEventSpeechLine "spank">>
			<<print $_stringsPre>>"You asked for this."
		<</addEventSpeechLine>>
		<<addEventSpeechLine "spank">>
			<<print $_stringsPre>>"This is for wasting my time."
		<</addEventSpeechLine>>
		<<addEventSpeechLine "spank">>
			<<print $_stringsPre>>"I'll stop when you've learned your lesson."
		<</addEventSpeechLine>>
		<<addEventSpeechLine "spank">>
