			<<print $_stringsPre>>"You're not going anywhere."
		<</addEventSpeechLine>>
		<<addEventSpeechLine "struggle">>
			<<print $_stringsPre>>"Don't make this difficult."
		<</addEventSpeechLine>>
		<<addEventSpeechLine "struggle">>
			<<print $_stringsPre>>"Stop fighting me."
		<</addEventSpeechLine>>
	<<else>>
