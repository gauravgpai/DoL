:: Widgets reaction-Sydney [widget]

<<widget "reaction-sydney-expose">>
	<<sydneyExpose>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-sydney-plead">>
	<<run statusCheck("Sydney")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<speechLine>>"I thought... you said lust was a sin..."<</speechLine>>
	<<else>>
		<<speechLine>>"I'm sorry, I'll be pure! Please stop!"<</speechLine>>
	<</if>>
<</widget>>

<<widget "pcLine-sydney-demand">>
	<<run statusCheck("Sydney")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<speechLine>>"I miss when you were pure. At least you didn't pull shit like this."<</speechLine>>
	<<else>>
		<<speechLine>>"What sort of punishment is this? Get off me!"<</speechLine>>
	<</if>>
<</widget>>

<<widget "pcLine-sydney-moan">>
	<<run statusCheck("Sydney")>>
	<<if !_sydneyChastity>>
		<<if _sydneyStatus.includes("corrupt")>>
			<<speechLine>>"You're the most delicious sin of all."<</speechLine>>
		<<else>>
			<<speechLine>>"Forever, as one."<</speechLine>>
		<</if>>
	<<else>>
		<<speechLine>>"You make me so lustful."<</speechLine>>
	<</if>>
<</widget>>
