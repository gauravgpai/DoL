			<<else>>
				<<if currentSkillValue("oralskill") gte 400>>
					<<addSpeechLine>><<He>> smiles as <<he>> sighs in pleasure.<</addSpeechLine>>
					<<addSpeechLine>>"You're awfully affectionate today." <<He>> <<= either("giggles","chuckles","smiles")>>.<</addSpeechLine>>
				<<else>>
					<<addSpeechLine>><<He>> <<= either("gasps","chuckles","giggles")>>. "That tickles!"<</addSpeechLine>>
					<<addSpeechLine>>"Is that all you're going to do?" <<he>> <<= either("chuckles","giggles","teases you")>>.<</addSpeechLine>>
				<</if>>
			<</if>>
		<</if>>
		<<if $speechVaginaVagina is 1 and C.npc.Robin.dom gte 70 and $fame.sex gte 600>>
			<<addSpeechLine>>"So... where would you rank mine?" <<He>> smiles.<</addSpeechLine>>
		<</if>>
		<<if $speechAnalLick is 1 and C.npc.Robin.dom lte 30>>
			<<addSpeechLine>>"It feels a bit ticklish!" <<He>> <<= either("giggles", "smiles", "chuckles")>>.<</addSpeechLine>>
			<<addSpeechLine>>"This feels a bit naughty," <<he>> <<= either("gasps", "says in surprise")>>.<</addSpeechLine>>
		<</if>>
		/* Once every line for this situation has been said, the turn goes to an ambient line or the mouth action instead of a repeat. */
		<<run takeSpeechBreather()>>
		<<speechSayOrPass>>
	<</if>>
<</widget>>
