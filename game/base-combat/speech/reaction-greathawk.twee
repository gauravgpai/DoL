:: Widgets reaction-GreatHawk [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-greathawk-plead">>
	<<speechLine>>"Y-you're going to take care of me, right?"<</speechLine>>
<</widget>>

<<widget "pcLine-greathawk-demand">>
	<<speechLine>>"Stop pecking me!"<</speechLine>>
<</widget>>

<<widget "pcLine-greathawk-moan">>
	<<speechLine>>"You're not a terror. You're all I need."<</speechLine>>
<</widget>>
