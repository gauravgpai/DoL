					<<addSpeechLine>><<He>> speaks. "Th... the belt's not going to make you stop loving me, is it?"<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> speaks. "I want this thing off, but I know it's for my own good."<</addSpeechLine>>
					<<addSpeechLine>><<He>> speaks. "Don't hurt yourself against the belt, it's a finger pincher."<</addSpeechLine>>
					<<addSpeechLine>><<He>> speaks. "I hope the belt's not a dealbreaker."<</addSpeechLine>>
			<</switch>>
		<</if>>

		/* Once every line for this situation has been said, the turn goes to an ambient line or the mouth action instead of a repeat. */
		<<run takeSpeechBreather()>>
		<<set _quietTurn to !hasSpeechLines()>>
		/* Ambient lines only compete on a quiet turn. */
		<<if _quietTurn>>
			<<if !$sydneyUniqueComments.includes("clothes")>>
				<<if $worn.upper.name is "nun's habit" or $worn.upper.name is "monk's habit">>
					<<if _sydneyStatus.includes("corrupt")>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> runs <<his>> hands over your $worn.upper.name. <<He>> almost seems nostalgic. <<npcincr Sydney purity 2>><<gspurity>><</addSpeechLine>>
					<<else>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> looks over your $worn.upper.name. "Does... wearing that make this all okay?" <<npcincr Sydney purity 2>><<gspurity>><</addSpeechLine>>
					<</if>>
				<<elseif $worn.neck.name is "holy pendant" or $worn.neck.name is "stone pendant">>
					<<if _sydneyStatus.includes("corrupt")>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<set $sydneySeen.pushUnique("holy pendant")>><<He>> stares at your $worn.neck.name. <<He>> almost seems nostalgic. <<npcincr Sydney purity 2>><<gspurity>><</addSpeechLine>>
					<<else>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<set $sydneySeen.pushUnique("holy pendant")>><<He>> looks over your $worn.neck.name. "Does... wearing that make this all okay?" <<npcincr Sydney purity 2>><<gspurity>><</addSpeechLine>>
					<</if>>
				<<elseif $worn.neck.name is "dark pendant">>
					<<if _sydneyStatus.includes("corrupt")>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<set $sydneySeen.pushUnique("dark pendant")>><<He>> stares at your $worn.neck.name. <<He>> seems to get lost in it for a moment. <<npcincr Sydney purity -2>><<lspurity>><</addSpeechLine>>
					<<else>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<set $sydneySeen.pushUnique("dark pendant")>><<He>> looks over your $worn.neck.name. "It's... so pretty, but also a little unsettling..." <<npcincr Sydney purity -2>><<lspurity>><</addSpeechLine>>
					<</if>>
				<<elseif $location is "school" and $exposed lte 0 and !wearingSchoolOutfit()>>
					<<if _sydneyStatus.includes("corrupt")>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> looks over your clothes and giggles. "That's not proper school uniform. Don't worry, I can help you take it off." <<set $combatgoal to "strip">><</addSpeechLine>>
					<<else>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> looks over your clothes. "Y-you should really adhere to the dress code, before you get in trouble..."<</addSpeechLine>>
					<</if>>
				<<elseif $worn.lower.name is "naked" and playerHasStrapon()>>
					<<if _sydneyStatus.includes("corrupt")>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> looks over your <<penisSimple>> and giggles. "Oh, these toys are fun."<</addSpeechLine>>
					<<else>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> looks over your <<penisSimple>> and blushes. "<<nnpc_Mum "Sirris">>'s always talking about these."<</addSpeechLine>>
					<</if>>
				<<elseif $exposed gte 1>>
					<<if _sydneyStatus.includes("corrupt")>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> looks over your body and giggles. "You look even better all exposed like this." <<npcincr Sydney lust 1>><<glust>><</addSpeechLine>>
					<<else>>
						<<addSpeechLine>><<set $sydneyUniqueComments.pushUnique("clothes")>><<He>> shyly looks over your exposed body. "Y-you're... you look... uhm..." <<He>> looks away for a moment. "You look good." <<npcincr Sydney lust 1>><<npcincr Sydney purity -2>><<gslust>><<lspurity>><</addSpeechLine>>
					<</if>>
				<</if>>
			<</if>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<addSpeechLine>><<He>> murmurs. "Sorry, I don't really know what I'm doing..."<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> speaks. "We sure know how to have fun."<</addSpeechLine>>
				<<default>>
					<<addSpeechLine>>"I used to get so nervous about this kind of thing..."<</addSpeechLine>>
			<</switch>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<addSpeechLine>><<He>> speaks. "This is... so sinful..."<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> speaks. "You've opened my eyes, being a sinner is too much fun!"<</addSpeechLine>>
				<<default>>
					<<addSpeechLine>><<He>> speaks. "I was always taught that this was sinful, but..."<</addSpeechLine>>
			<</switch>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<addSpeechLine>><<He>> murmurs. "N...not too rough, please..."<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> speaks. "I can handle anything you have for me. Come on, show me what you've got!"<</addSpeechLine>>
				<<default>>
					<<addSpeechLine>><<He>> speaks. "I... you can be a little rough, if you want..."<</addSpeechLine>>
			<</switch>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<addSpeechLine>><<He>> takes a deep breath. "I... I can do this."<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> speaks. "Think you can keep up?"<</addSpeechLine>>
				<<default>>
					<<addSpeechLine>><<He>> speaks. "I think I can keep pace with you, now."<</addSpeechLine>>
			<</switch>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<addSpeechLine>><<He>> takes a deep breath. "We... need to stay quiet..."<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> giggles. "Shh!"<</addSpeechLine>>
				<<default>>
					<<addSpeechLine>><<He>> speaks. "Let's try not to get caught..."<</addSpeechLine>>
			<</switch>>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust">>
					<<addSpeechLine>><<He>> looks upwards. "Forgive me..."<</addSpeechLine>>
				<<case "corrupt" "corruptLust">>
					<<addSpeechLine>><<He>> giggles. "Looks like I'm due for some discipline. Maybe you can punish me?"<</addSpeechLine>>
				<<default>>
					<<addSpeechLine>><<He>> giggles. "I've sinned... is this my punishment?"<</addSpeechLine>>
			<</switch>>
			<<if $location is "temple">>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<addSpeechLine>><<He>> looks upwards. "S...such a sin, doing this on such holy ground..."<</addSpeechLine>>
					<<case "corrupt" "corruptLust">>
						<<addSpeechLine>><<He>> giggles. "Let's defile this place."<</addSpeechLine>>
					<<default>>
						<<addSpeechLine>><<He>> giggles. "W...we're doing this in the temple, and nothing is stopping us..."<</addSpeechLine>>
				<</switch>>
			<<elseif $location is "school">>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<addSpeechLine>><<He>> looks around nervously. "If... if someone caught us..."<</addSpeechLine>>
					<<case "corrupt" "corruptLust">>
						<<addSpeechLine>><<He>> giggles. "I sure hope one of the other students hear us."<</addSpeechLine>>
					<<default>>
						<<addSpeechLine>><<He>> looks around. "I hope there's no one waiting in line..."<</addSpeechLine>>
				<</switch>>
			<<else>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<addSpeechLine>><<He>> looks around nervously. "Here, of all places..."<</addSpeechLine>>
					<<case "corrupt" "corruptLust">>
						<<addSpeechLine>><<He>> giggles. "Think anyone will find us?"<</addSpeechLine>>
					<<default>>
						<<addSpeechLine>><<He>> looks around. "I think we're safe."<</addSpeechLine>>
				<</switch>>
			<</if>>
		<</if>>
		<<speechSayOrPass _quietTurn>>
	<</if>>
<</widget>>
