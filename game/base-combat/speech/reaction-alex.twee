:: Widgets reaction-Alex [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "pc-line-alex-plead">>
	<<addSpeechLine>>"Alex, control yourself!"<</addSpeechLine>>
<</widget>>

<<widget "pc-line-alex-demand">>
	<<addSpeechLine>>"Alex, you idiot! Control yourself."<</addSpeechLine>>
<</widget>>

<<widget "pc-line-alex-moan">>
	<<addSpeechLine>>"I couldn't ask for a better partner."<</addSpeechLine>>
<</widget>>
