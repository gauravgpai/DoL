:: Widgets reaction-Alex [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-alex-plead">>
	<<speechLine>>"Alex, control yourself!"<</speechLine>>
<</widget>>

<<widget "pcLine-alex-demand">>
	<<speechLine>>"Alex, you idiot! Control yourself."<</speechLine>>
<</widget>>

<<widget "pcLine-alex-moan">>
	<<speechLine>>"I couldn't ask for a better partner."<</speechLine>>
<</widget>>
