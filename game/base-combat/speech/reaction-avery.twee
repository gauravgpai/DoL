:: Widgets reaction-Avery [widget]

<<widget "reaction-avery-kissImminent">>
	<<His>> eyes flick between your lips and your eyes with naked hunger. <<if C.npc.Avery.rage lt 20>>"Come here, <<pcpetname "Avery">>..."<</if>>
<</widget>>

<<widget "reaction-avery-kissSkin">>
	<<set _bodyPart to _args[0]>>

	<<if _bodyPart is "forehead">>
		<<if C.npc.Avery.love gte 60 and C.npc.Avery.rage lt 20 and $enemytrust gt 60>>
			"That's a good <<pcpetname "Avery" "my">>," <<he>> murmurs against your skin.
		<</if>>
	<<else>>
		As <<he>> lavishes attention on your <<if _bodyPart is "chest">><<chest>><<elseif _bodyPart is "bottom">><<bottom>><<else>>thighs<</if>>, it's interspersed with <<= C.npc.Avery.rage gte 60 ? "harsh nips and bites" : C.npc.Avery.rage gte 20 ? "biting and sucking" : "nips and the odd bite">>. <<= $awareness gte 100 ? "<<He>> must be" : "It's almost like <<hes>>">> trying to leave a mark.
	<</if>>
<</widget>>

<<widget "reaction-avery-fondle">>
	<<if !_avery_fondle_speech>>
		<<set _bodyPart to _args[0]>>

		<<if $consensual or (!$consensual and $enemyanger lte 20)>>
			<<set _avery_fondle_speech to 1>>
			<<switch _bodyPart>>
				<<case "chest" "breasts">>
					"Your <<chestsimple>> <<= $player.breastsize gte 5 ? "are so soft, and" : $player.breastsize gte 1 ? "are such a pleasant handful, and so" : "is so sleek, and your nipples such">> fun to play with..."
				<<case "bottom">>
					"You have such <<= $player.bottomsize gte 6 ? "a soft" : $player.bottomsize gte 3 ? "a nice" : "an adorable">> <<bottomsimple>>."
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "reaction-avery-initiative">>
	<<if C.npc.Avery.rage gte 60>>
		<<He>> <<= either("scoffs","huffs","rolls <<his>> eyes")>>. "Taking initiative, are we? At least you understand what purpose you serve."
	<<else>>
		<<He>> <<= $averyragerevealed is 1 ? "smirks" : "smiles">>. "Taking initiative, are we?" <<He>> seems <<= $averyragerevealed is 1 ? "amused" : "pleased">>.
	<</if>>
<</widget>>

<<widget "reaction-avery-undress">>
	<<if C.npc.Avery.rage gte 60>>
		<<He>> narrows <<his>> eyes at you. "You'll leave that to me unless told otherwise."
	<<else>>
		<<print either(
			`<<He>> lets out a laugh. "Trying to save us both time, hm?"`,
			`<<He>> raises both brows. "My, how bold of you, <<pcpetname "Avery">>."`
		)>>
	<</if>>
<</widget>>

<<widget "reaction-avery-choke">>
	<<if _daddy>>
		<<cleareventpool>>
		<<addinlineevent "avery_daddy_choke_classic" 0.5>>
			<<He>> <<laughs>>. "Let's see if you can still beg for <<nnpc_mummy "Avery">> with <<his>> hand around your throat."
		<</addinlineevent>>
		<<addinlineevent "avery_daddy_choke_variations" 2>>
			<<if C.npc.Avery.rage gte 60>>
				"I'll give you what you want," <<he>> murmurs darkly, "but not because you begged me to." <<His>> hand squeezes around your throat a little harder.
			<<elseif C.npc.Avery.rage gte 20>>
				"That's right, <<pcpetname "Avery">>." <<He>> <<laughs>> as <<his>> hand squeezes down a little harder. "Finally, you know how to speak to me."
			<<else>>
				"As you wish, <<pcpetname "Avery">>," <<he>> purrs. "Leave it to <<nnpc_mummy "Avery">>."
			<</if>>
		<</addinlineevent>>
		<<runeventpool>>
	<</if>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "reaction-avery-plead">>
	<<set _possibleSentences to []>>
	<<if !$avery_mansion>>
		<<set _possibleSentences.push({ sentence: `"Was this all the date was for...?"`, dialogueID: "avery_plead_premansion" })>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<set _possibleSentences.push({ sentence: `"I'm sorry! I didn't mean to!"`, dialogueID: "avery_plead_hunting_1" })>>
			<<set _possibleSentences.push({ sentence: `"Please, I promise I'll do better! I promise...!"`, dialogueID: "avery_plead_hunting_2" })>>
		<<elseif $averyromance is 1>>
			<<set _possibleSentences.push({ sentence: `"I love you, Avery. Please don't do this to me!"`, dialogueID: "avery_plead_romance" })>>
		<<else>>
			<<set _possibleSentences.push({ sentence: `"I'm sorry, Avery, please forgive me...!"`, dialogueID: "avery_plead_mansion" })>>
		<</if>>
	<</if>>
	<<pcLine _possibleSentences>>
<</widget>>

<<widget "reaction-avery-demand">>
	<<set _possibleSentences to []>>
	<<if !$avery_mansion>>
		<<set _possibleSentences.push({ sentence: `"You don't pay me enough to treat me like this!"`, dialogueID: "avery_demand_default"})>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<set _possibleSentences.push({ sentence: `"Get the hell away from me! You're taking this too far, Avery!"`, dialogueID: "avery_demand_hunting"})>>
		<<elseif $averyromance is 1>>
			<<set _possibleSentences.push({ sentence: `"I told you I loved you, but I won't hesitate to leave if you don't stop this right now!"`, dialogueID: "avery_demand_romance"})>>
		<<else>>
			<<set _possibleSentences.push({ sentence: `"Stop it, Avery! I'm<<if $averySeen.includes("walkParkSOYes") or $averyromance>> your <<girlfriend>>,<</if>> not your punching bag!"`, dialogueID: "avery_demand_mansion"})>>
		<</if>>
	<</if>>
	<<pcLine _possibleSentences>>
<</widget>>

<<widget "reaction-avery-forgive">>
	<<if $avery_fate is undefined>>
		<<set _possibleSentences to [{ sentence: `"You're just angry," you say. "Everyone gets angry sometimes. I forgive you."` }]>>
		<<pcLine _possibleSentences>>
	<<else>>
		<<set _possibleSentences to [{ sentence: `"Now I understand why you get so angry, Avery," you say. "And I forgive you."` }]>>
		<<pcLine _possibleSentences>>
	<</if>>
<</widget>>

<<widget "reaction-avery-moan">>
	<<set _possibleSentences to []>>
	<<set _daddy to $submissive gte 1150 and random(1, 4) is 1>>
	<<if $avery_fate is "ascended">>
		<<set _possibleSentences.push({ sentence: `"I'm all yours, Hound."`, dialogueID: "avery_moan_ascended"})>>
	<<elseif $averyromance>>
		<<set _possibleSentences.push({ sentence: `"I love you, Avery."`, dialogueID: "avery_moan_romance"})>>
	<<elseif _daddy>>
		<<set _possibleSentences.push({ sentence: `"Put me in my place, <<nnpc_mummy "Avery">>."`, dialogueID: "avery_moan_daddy"})>>
	<<elseif isLoveInterest("Avery")>> 
		<<if !$avery_mansion>>
			<<set _possibleSentences.push({ sentence: `"Take me away from that place, take me with you."`, dialogueID: "avery_moan_premansion"})>>
		<<else>>
			<<set _possibleSentences.push({ sentence: `"Let me show you how grateful I am, use me as much as you want."`, dialogueID: "avery_moan_mansion"})>>
		<</if>>
	<<else>>
		<<set _possibleSentences.push({ sentence: `"You're worth more than any payout."`, dialogueID: "avery_moan_default"})>>
	<</if>>
	<<pcLine _possibleSentences>>
<</widget>>
