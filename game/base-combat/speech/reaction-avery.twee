:: Widgets reaction-Avery [widget]

<<widget "reaction-avery-kissImminent">>
	<<His>> eyes flick between your lips and your eyes with naked hunger. <<if C.npc.Avery.rage lt 20>>"Come here, <<pcpetname "Avery">>..."<</if>>
<</widget>>

<<widget "reaction-avery-kissSkin">>
	<<set _bodyPart to _args[0]>>

	<<if _bodyPart is "forehead">>
		<<if C.npc.Avery.love gte 60 and C.npc.Avery.rage lt 20 and $enemytrust gt 60>>
			"That's a good <<pcpetname "Avery" "my">>," <<he>> murmurs against your skin.
		<</if>>
	<<else>>
		As <<he>> lavishes attention on your <<if _bodyPart is "chest">><<chest>><<elseif _bodyPart is "bottom">><<bottom>><<else>>thighs<</if>>, it's interspersed with <<= C.npc.Avery.rage gte 60 ? "harsh nips and bites" : C.npc.Avery.rage gte 20 ? "biting and sucking" : "nips and the odd bite">>. <<= $awareness gte 100 ? "<<He>> must be" : "It's almost like <<hes>>">> trying to leave a mark.
	<</if>>
<</widget>>

<<widget "reaction-avery-fondle">>
	<<if !_avery_fondle_speech>>
		<<set _bodyPart to _args[0]>>

		<<if $consensual or (!$consensual and $enemyanger lte 20)>>
			<<set _avery_fondle_speech to 1>>
			<<switch _bodyPart>>
				<<case "chest" "breasts">>
					"Your <<chestsimple>> <<= $player.breastsize gte 5 ? "are so soft, and" : $player.breastsize gte 1 ? "are such a pleasant handful, and so" : "is so sleek, and your nipples such">> fun to play with..."
				<<case "bottom">>
					"You have such <<= $player.bottomsize gte 6 ? "a soft" : $player.bottomsize gte 3 ? "a nice" : "an adorable">> <<bottomsimple>>."
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "reaction-avery-initiative">>
	<<if C.npc.Avery.rage gte 60>>
		<<He>> <<= either("scoffs","huffs","rolls <<his>> eyes")>>. "Taking initiative, are we? At least you understand what purpose you serve."
	<<else>>
		<<He>> <<= $averyragerevealed is 1 ? "smirks" : "smiles">>. "Taking initiative, are we?" <<He>> seems <<= $averyragerevealed is 1 ? "amused" : "pleased">>.
	<</if>>
<</widget>>

<<widget "reaction-avery-undress">>
	<<if C.npc.Avery.rage gte 60>>
		<<He>> narrows <<his>> eyes at you. "You'll leave that to me unless told otherwise."
	<<else>>
		<<print either(
			`<<He>> lets out a laugh. "Trying to save us both time, hm?"`,
			`<<He>> raises both brows. "My, how bold of you, <<pcpetname "Avery">>."`
		)>>
	<</if>>
<</widget>>

<<widget "reaction-avery-choke">>
	<<if _daddy>>
		<<speechPool "Avery">>
		<<speechLine 0.5>>
			<<He>> <<laughs>>. "Let's see if you can still beg for <<nnpc_mummy "Avery">> with <<his>> hand around your throat."
		<</speechLine>>
		<<speechLine 2>>
			<<if C.npc.Avery.rage gte 60>>
				"I'll give you what you want," <<he>> murmurs darkly, "but not because you begged me to." <<His>> hand squeezes around your throat a little harder.
			<<elseif C.npc.Avery.rage gte 20>>
				"That's right, <<pcpetname "Avery">>." <<He>> <<laughs>> as <<his>> hand squeezes down a little harder. "Finally, you know how to speak to me."
			<<else>>
				"As you wish, <<pcpetname "Avery">>," <<he>> purrs. "Leave it to <<nnpc_mummy "Avery">>."
			<</if>>
		<</speechLine>>
		<<speechSay>>
	<</if>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-avery-plead">>
	<<if !$avery_mansion>>
		<<speechLine>><<set $speechSpecialDialogue to "avery_plead_premansion">>"Was this all the date was for...?"<</speechLine>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_plead_hunting_1">>"I'm sorry! I didn't mean to!"<</speechLine>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_plead_hunting_2">>"Please, I promise I'll do better! I promise...!"<</speechLine>>
		<<elseif $averyromance is 1>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_plead_romance">>"I love you, Avery. Please don't do this to me!"<</speechLine>>
		<<else>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_plead_mansion">>"I'm sorry, Avery, please forgive me...!"<</speechLine>>
		<</if>>
	<</if>>
<</widget>>

<<widget "pcLine-avery-demand">>
	<<if !$avery_mansion>>
		<<speechLine>><<set $speechSpecialDialogue to "avery_demand_default">>"You don't pay me enough to treat me like this!"<</speechLine>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_demand_hunting">>"Get the hell away from me! You're taking this too far, Avery!"<</speechLine>>
		<<elseif $averyromance is 1>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_demand_romance">>"I told you I loved you, but I won't hesitate to leave if you don't stop this right now!"<</speechLine>>
		<<else>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_demand_mansion">>"Stop it, Avery! I'm<<if $averySeen.includes("walkParkSOYes") or $averyromance>> your <<girlfriend>>,<</if>> not your punching bag!"<</speechLine>>
		<</if>>
	<</if>>
<</widget>>

<<widget "pcLine-avery-forgive">>
	<<if $avery_fate is undefined>>
		<<speechLine>>"You're just angry," you say. "Everyone gets angry sometimes. I forgive you."<</speechLine>>
	<<else>>
		<<speechLine>>"Now I understand why you get so angry, Avery," you say. "And I forgive you."<</speechLine>>
	<</if>>
<</widget>>

<<widget "pcLine-avery-moan">>
	<<set _daddy to $submissive gte 1150 and random(1, 4) is 1>>
	<<if $avery_fate is "ascended">>
		<<speechLine>><<set $speechSpecialDialogue to "avery_moan_ascended">>"I'm all yours, Hound."<</speechLine>>
	<<elseif $averyromance>>
		<<speechLine>><<set $speechSpecialDialogue to "avery_moan_romance">>"I love you, Avery."<</speechLine>>
	<<elseif _daddy>>
		<<speechLine>><<set $speechSpecialDialogue to "avery_moan_daddy">>"Put me in my place, <<nnpc_mummy "Avery">>."<</speechLine>>
	<<elseif isLoveInterest("Avery")>> 
		<<if !$avery_mansion>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_moan_premansion">>"Take me away from that place, take me with you."<</speechLine>>
		<<else>>
			<<speechLine>><<set $speechSpecialDialogue to "avery_moan_mansion">>"Let me show you how grateful I am, use me as much as you want."<</speechLine>>
		<</if>>
	<<else>>
		<<speechLine>><<set $speechSpecialDialogue to "avery_moan_default">>"You're worth more than any payout."<</speechLine>>
	<</if>>
<</widget>>
