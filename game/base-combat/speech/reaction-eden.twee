:: Widgets reaction-Eden [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-eden-plead">>
	<<speechLine>>"N...not so rough, Eden..."<</speechLine>>
<</widget>>

<<widget "pcLine-eden-demand">>
	<<speechLine>>"I'm not your prey today, leave me alone."<</speechLine>>
<</widget>>

<<widget "pcLine-eden-moan">>
	<<speechLine>>"I belong to you, and you alone."<</speechLine>>
<</widget>>
