:: Widgets reaction-Eden [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "reaction-eden-plead">>
	<<set _possibleSentences to [{ sentence: `"N...not so rough, Eden..."`, dialogueID: "eden_plead_default" }]>>
	<<pcLine _possibleSentences>>
<</widget>>

<<widget "reaction-eden-demand">>
	<<set _possibleSentences to [{ sentence: `"I'm not your prey today, leave me alone."`, dialogueID: "eden_demand_default" }]>>
	<<pcLine _possibleSentences>>
<</widget>>

<<widget "reaction-eden-moan">>
	<<set _possibleSentences to [{ sentence: `"I belong to you, and you alone."`, dialogueID: "eden_moan_default" }]>>
	<<pcLine _possibleSentences>>
<</widget>>
