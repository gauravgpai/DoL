:: Widgets reaction-BlackWolf [widget]

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-blackwolf-plead">>
	<<speechLine>>"Gently, please..."<</speechLine>>
<</widget>>

<<widget "pcLine-blackwolf-demand">>
	<<speechLine>>"Down. DOWN!"<</speechLine>>
<</widget>>

<<widget "pcLine-blackwolf-moan">>
	<<if $wolfpackleader is 1>>
		<<speechLine>>"Good <<nnpc_gendery "Black Wolf">>. Keep going."<</speechLine>>
	<<else>>
		<<speechLine>>"<<print ($settings.pregnancySpeechEnabled ? "Breed" : "Fuck")>> me, alpha!"<</speechLine>>
	<</if>>
<</widget>>
