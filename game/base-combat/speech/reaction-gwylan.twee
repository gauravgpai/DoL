:: Widgets reaction-Gwylan [widget]

<<widget "reaction-gwylan-kiss">>
	<<gwylanKiss>>
	<<if _pcKissVirginityTaken>>
		<br><br>
	<</if>>
<</widget>>

<<widget "reaction-gwylan-kissDeep">>
	<<gwylanKiss 1>>
	<<if _pcKissVirginityTaken>>
		<br><br>
	<</if>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "pc-line-gwylan-plead">>
	<<if $abomination is 1>>
		<<addSpeechLine>>
			"Gwylan, come back! I'm scared!"
		<</addSpeechLine>>
	<<elseif $hypnosis_traits.devotion gte 1 or $combat_hypnosis>>
		<<addSpeechLine>>
			"Gwylan, please, I can't think straight!"
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine>>
			"Gwylan, please, this doesn't feel right!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-gwylan-demand">>
	<<if $abomination is 1>>
		<<addSpeechLine>>
			"Gwylan, I know you're in there! Take control!"
		<</addSpeechLine>>
	<<elseif $hypnosis_traits.devotion gte 4 or $combat_hypnosis>>
		<<addSpeechLine>>
			"Gwylan, stop! Get out of my head!"
		<</addSpeechLine>>
	<<elseif $gwylanSeen.includes("romance")>>
		<<addSpeechLine>>
			"Gwylan, stop this! You promised!"
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine>>
			"Gwylan, stop this!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-gwylan-moan">>
	<<addSpeechLine>>
		"I think I'm bewitched."
	<</addSpeechLine>>
<</widget>>
