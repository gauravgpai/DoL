:: Widgets reaction-Gwylan [widget]

<<widget "reaction-gwylan-kiss">>
	<<gwylanKiss>>
	<<if _pcKissVirginityTaken>>
		<br><br>
	<</if>>
<</widget>>

<<widget "reaction-gwylan-kissDeep">>
	<<gwylanKiss 1>>
	<<if _pcKissVirginityTaken>>
		<br><br>
	<</if>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "pcLine-gwylan-plead">>
	<<if $abomination is 1>>
		<<speechLine>>"Gwylan, come back! I'm scared!"<</speechLine>>
	<<elseif $hypnosis_traits.devotion gte 1 or $combat_hypnosis>>
		<<speechLine>>"Gwylan, please, I can't think straight!"<</speechLine>>
	<<else>>
		<<speechLine>>"Gwylan, please, this doesn't feel right!"<</speechLine>>
	<</if>>
<</widget>>

<<widget "pcLine-gwylan-demand">>
	<<if $abomination is 1>>
		<<speechLine>>"Gwylan, I know you're in there! Take control!"<</speechLine>>
	<<elseif $hypnosis_traits.devotion gte 4 or $combat_hypnosis>>
		<<speechLine>>"Gwylan, stop! Get out of my head!"<</speechLine>>
	<<elseif $gwylanSeen.includes("romance")>>
		<<speechLine>>"Gwylan, stop this! You promised!"<</speechLine>>
	<<else>>
		<<speechLine>>"Gwylan, stop this!"<</speechLine>>
	<</if>>
<</widget>>

<<widget "pcLine-gwylan-moan">>
	<<speechLine>>"I think I'm bewitched."<</speechLine>>
<</widget>>
